# Root env for Admin panel HTTPS deploy (build-args + Caddy).
# Copy to `.env` at repo root:
#   cp .env.admin.example .env

ADMIN_DOMAIN=admin.yourdomain.com
ACME_EMAIL=ops@yourdomain.com

# Baked into the SPA at image build time — rebuild after any change
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=

# GHCR (optional pull instead of --build)
IMAGE_TAG=latest
GITHUB_REPOSITORY_OWNER=your-gh-user-or-org
