# Root env for backend / production HTTPS deploy (NOT API secrets).
# Copy to `.env` next to docker-compose.*.yml
#
#   cp .env.backend.example .env

# Public hostnames (DNS A/AAAA must point at this server)
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# Let's Encrypt registration email
ACME_EMAIL=ops@yourdomain.com

# Public URLs (also set inside apps/api/.env — compose can override)
API_BASE_URL=https://api.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com

# GHCR image pull (production)
IMAGE_TAG=latest
GITHUB_REPOSITORY_OWNER=your-gh-user-or-org

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000

# Optional: bind API on host loopback for local curl (default in compose)
# PUBLISH_API_PORT=127.0.0.1:4000
