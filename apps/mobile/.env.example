# For Expo Go on a physical phone, use your PC LAN IP (not localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
EXPO_PUBLIC_APP_ENV=development

# After `eas init` — paste the project ID (also used for Expo push)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Production mobile (EAS secrets / eas.json env) — use HTTPS API
# EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# EXPO_PUBLIC_APP_ENV=production
