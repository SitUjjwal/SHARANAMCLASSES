# SHARANAM CLASSES API — STAGING template
# Copy to apps/api/.env on the staging server (never commit secrets).
#
# Use SEPARATE resources from production:
#   - Supabase staging project
#   - Razorpay TEST keys
#   - R2 staging bucket / prefix
#   - Staging admin URL in CORS

NODE_ENV=production
APP_ENV=staging
PORT=4000
API_BASE_URL=https://api-staging.yourdomain.com
CORS_ORIGINS=https://admin-staging.yourdomain.com

ADMIN_EMAILS=you@yourdomain.com

JWT_SECRET=replace-with-at-least-32-random-chars
JWT_EXPIRES_IN=7d

SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sharanam-pdfs-staging
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Razorpay TEST keys on staging
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FIREBASE_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=info
LOG_DIR=/app/logs
LOG_TO_CONSOLE=true
SHUTDOWN_TIMEOUT_MS=15000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

BACKUP_ENGINE_CRON=0 3 * * *
BACKUP_ENGINE_TZ=Asia/Kolkata
BACKUP_RETAIN_DAYS=14
