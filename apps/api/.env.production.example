# SHARANAM CLASSES API — production template
# Copy to apps/api/.env on the server (never commit secrets).
#
# Your short names → canonical (aliases also accepted):
#   RAZORPAY_KEY           → RAZORPAY_KEY_ID
#   RAZORPAY_SECRET        → RAZORPAY_KEY_SECRET
#   CLOUDFLARE_ACCOUNT_ID  → R2_ACCOUNT_ID
#   CLOUDFLARE_ACCESS_KEY  → R2_ACCESS_KEY_ID
#   CLOUDFLARE_SECRET_KEY  → R2_SECRET_ACCESS_KEY
#   FCM_SERVER_KEY         → NOT USED (use Firebase service account JSON instead)

NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com

ADMIN_EMAILS=you@yourdomain.com

JWT_SECRET=replace-with-at-least-32-random-chars
JWT_EXPIRES_IN=7d

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Cloudflare R2 (canonical names)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sharanam-pdfs
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Razorpay (live keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase / FCM — service account (NOT legacy FCM_SERVER_KEY)
FIREBASE_SERVICE_ACCOUNT_JSON=
# or: FIREBASE_SERVICE_ACCOUNT_PATH=/secure/firebase-service-account.json

LOG_LEVEL=info
LOG_DIR=/app/logs
LOG_TO_CONSOLE=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

BACKUP_ENGINE_CRON=0 2 * * *
BACKUP_ENGINE_TZ=Asia/Kolkata
BACKUP_RETAIN_DAYS=30
