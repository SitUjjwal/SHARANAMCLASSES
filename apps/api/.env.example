NODE_ENV=development
APP_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Rate limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
ADMIN_EMAILS=

# JWT (not enforced on routes yet)
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Supabase (server-side)
# SUPABASE_URL must be https://<project-ref>.supabase.co — NOT a JWT/API key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 (PDF binaries) — required in production
# Create an R2 bucket + API token with Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sharanam-pdfs
# Public URL base (custom domain or https://pub-xxxxx.r2.dev) — no trailing slash
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Signed download URL lifetime in seconds (default 3600)
R2_SIGNED_URL_TTL_SECONDS=3600

# Logging (JSON files under LOG_DIR, rotated daily + by size)
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_FILES=14
LOG_MAX_SIZE=20M
# LOG_TO_CONSOLE=true


# Razorpay (server-only). Dashboard → API Keys. Never expose KEY_SECRET to clients.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Optional webhook secret (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (server-only) — Module 7 push send
# Prefer JSON string OR path to service-account JSON (gitignored)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# GOOGLE_APPLICATION_CREDENTIALS= also works (standard ADC)

# Reminder Engine (scheduled jobs → Notification Service)
# REMINDER_ENGINE_ENABLED=false
REMINDER_ENGINE_CRON=*/15 * * * *
REMINDER_ENGINE_TZ=Asia/Kolkata
REMINDER_LIVE_LEAD_MINUTES=60
REMINDER_LIVE_WINDOW_MINUTES=12
REMINDER_EXPIRY_DAYS=7,3,1
REMINDER_CHAPTER_LOOKBACK_HOURS=36
REMINDER_MISSED_LOOKBACK_HOURS=3

# Backup Engine (Module 12) — nightly JSON+gzip archive to R2
# BACKUP_ENGINE_ENABLED=false
BACKUP_ENGINE_CRON=0 2 * * *
BACKUP_ENGINE_TZ=Asia/Kolkata
BACKUP_RETAIN_DAYS=30
