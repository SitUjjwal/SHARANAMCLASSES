# Example env for `docker compose` interpolation (NOT secrets).
# Copy to `.env` at repo root for compose variable substitution.
# API secrets still live in `apps/api/.env`.

API_PORT=4000
ADMIN_PORT=8080
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Baked into admin SPA at image build time (required for login — do not leave blank)
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=
